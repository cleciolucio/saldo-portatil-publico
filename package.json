{
  "name": "saldo-portatil-publico",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Controle financeiro offline, público e personalizável, com dados fictícios e automação QA.",
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node tools/build-artifacts.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint web/src tools tests *.mjs",
    "format": "prettier --write web/src web/index.html tests tools/*.mjs *.mjs *.ts *.json docs README.md .github/workflows/*.yml .vscode/*.json",
    "format:check": "prettier --check web/src web/index.html tests tools/*.mjs *.mjs *.ts *.json docs README.md .github/workflows/*.yml .vscode/*.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "qa:web": "playwright test",
    "qa:web:ui": "playwright test --ui",
    "qa:web:headed": "playwright test --headed",
    "qa:report": "playwright show-report reports/playwright",
    "qa:bdd": "node tools/bdd.mjs web",
    "qa:bdd:mobile-web": "node tools/bdd.mjs mobile-web",
    "qa:bdd:iphone-web": "node tools/bdd.mjs iphone-web",
    "qa:bdd:dry": "cucumber-js --config cucumber.mjs --dry-run",
    "qa:mobile:android": "node tools/bdd.mjs android",
    "qa:mobile:ios": "node tools/bdd.mjs ios",
    "qa:mobile:dry": "cucumber-js --config cucumber.mobile.mjs --dry-run",
    "qa:check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run qa:portable && npm run qa:production && npm run qa:web && npm run qa:bdd",
    "browsers:install": "playwright install chromium firefox webkit",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:android:build": "node tools/mobile-build.mjs android",
    "mobile:ios:build": "node tools/mobile-build.mjs ios",
    "appium": "node tools/appium.mjs server",
    "appium:drivers": "node tools/appium.mjs drivers",
    "doctor": "node tools/doctor.mjs",
    "docs:check": "node tools/check-docs.mjs",
    "mobile:init:android": "cap add android",
    "mobile:init:ios": "cap add ios",
    "mobile:android:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-android.ps1",
    "mobile:android:emulator": "node tools/emulator.mjs",
    "qa:portable": "node tools/test-portable.mjs",
    "qa:production": "node tools/test-production.mjs",
    "qa:appium:server": "node tools/test-appium-server.mjs",
    "security:production": "npm audit --omit=dev --audit-level=moderate",
    "qa:tools:setup": "node tools/setup-qa-tools.mjs",
    "dev:qa": "vite --mode qa --host 127.0.0.1",
    "build:qa": "vite build --mode qa && node tools/build-artifacts.mjs --qa",
    "qa:k6:smoke": "node tools/k6.mjs smoke",
    "qa:k6:load": "node tools/k6.mjs load",
    "qa:k6:stress": "node tools/k6.mjs stress",
    "qa:k6:soak": "node tools/k6.mjs soak",
    "qa:k6:browser": "node tools/k6.mjs browser",
    "qa:k6:mobile": "node tools/k6.mjs browser-mobile",
    "qa:cluster:doctor": "node tools/k8s.mjs doctor",
    "qa:cluster:create": "node tools/k8s.mjs create",
    "qa:cluster:deploy": "node tools/k8s.mjs deploy",
    "qa:cluster:validate": "node tools/k8s.mjs validate",
    "qa:cluster:collect": "node tools/k8s.mjs collect",
    "qa:k9s": "node tools/k8s.mjs k9s",
    "qa:cluster:web": "node tools/k8s.mjs web",
    "qa:cluster:k6": "node tools/k8s.mjs load",
    "qa:mobile:sync": "npm run build:qa && node tools/mobile-qa-sync.mjs",
    "qa:positive": "playwright test --grep=\"@positive\"",
    "qa:negative": "playwright test --grep=\"@negative|NEG-|NEGATIVE\"",
    "qa:regression": "playwright test",
    "qa:integration": "playwright test --grep=\"@integration\"",
    "qa:full": "npm run qa:check && npm run qa:bdd:mobile-web && npm run qa:bdd:iphone-web && npm run build:qa && npm run qa:k6:smoke && npm run qa:k6:load && npm run qa:k6:browser && npm run qa:k6:mobile && npm run qa:k6:stress && npm run qa:k6:soak && npm run qa:cluster:validate && npm run qa:evidence:check",
    "qa:evidence:check": "node tools/evidence-check.mjs",
    "qa:cluster:integration": "node tools/k8s.mjs integration"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/filesystem": "8.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.65.1",
    "@cucumber/cucumber": "13.3.0",
    "@axe-core/playwright": "4.14.0",
    "appium": "3.9.0",
    "webdriverio": "10.2.0",
    "vite": "8.3.8",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cleciolucio/saldo-portatil-publico.git"
  },
  "bugs": {
    "url": "https://github.com/cleciolucio/saldo-portatil-publico/issues"
  },
  "homepage": "https://github.com/cleciolucio/saldo-portatil-publico#readme"
}
