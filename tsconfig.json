{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["*.ts", "tests/e2e/**/*.ts", "tests/helpers/**/*.ts"]
}
